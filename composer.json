{
    "name": "super-kernel/scan-isolation",
    "description": "Anonymous scan callback isolation for SuperKernel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4.27 <8.5",
        "super-kernel/attribute": "dev-main"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpunit/phpunit": "^13.4.5"
    },
    "suggest": {
        "ext-pcntl": "Enables preferred direct-fork anonymous Closure execution on supported platforms."
    },
    "autoload": {
        "psr-4": {
            "SuperKernel\\ScanIsolation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SuperKernel\\ScanIsolation\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "@php vendor/bin/php-cs-fixer fix --show-progress=bar --no-ansi",
        "format:check": "@php vendor/bin/php-cs-fixer check --show-progress=bar --no-ansi --diff",
        "test": "@php vendor/bin/phpunit"
    }
}
